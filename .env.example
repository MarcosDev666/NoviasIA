# ---------------------------------------------------------------
# Una sola API key para toda la app
# ---------------------------------------------------------------
# Copiá este archivo como .env.local y completá NOVIASIA_API_KEY.
#
# Si NO la configurás, la app igual funciona: usa el motor local de
# personalidades (lib/persona.ts). No se rompe nada.
#
# Guía con links: API-KEYS.md

# La única que hace falta. Sin exportar, sin prefijos raros.
NOVIASIA_API_KEY=

# ---------------------------------------------------------------
# Opcional: sólo si querés usar otro proveedor.
# Por defecto ya apunta a Groq, que es gratis y no pide tarjeta.
# ---------------------------------------------------------------

# Groq (por defecto)
NOVIASIA_API_URL=https://api.groq.com/openai/v1/chat/completions
NOVIASIA_MODEL=llama-3.1-8b-instant

# OpenRouter
# NOVIASIA_API_URL=https://openrouter.ai/api/v1/chat/completions
# NOVIASIA_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Cerebras
# NOVIASIA_API_URL=https://api.cerebras.ai/v1/chat/completions
# NOVIASIA_MODEL=llama3.1-8b

# Mistral
# NOVIASIA_API_URL=https://api.mistral.ai/v1/chat/completions
# NOVIASIA_MODEL=mistral-small-latest

# OpenAI
# NOVIASIA_API_URL=https://api.openai.com/v1/chat/completions
# NOVIASIA_MODEL=gpt-4o-mini
